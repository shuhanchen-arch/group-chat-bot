# 复制为 .env 后修改
DRIVER=~fastapi
HOST=0.0.0.0
# 8080 被本地 Qwen 占用，机器人用 8090
PORT=8090
# NapCat 反向 WebSocket 连接时使用的 token，两边填一样
ONEBOT_ACCESS_TOKEN=change-me
COMMAND_START=["/"]
NICKNAME=["机器人"]
# 你的大号 QQ，不受次数限制
SUPERUSERS=["123456789"]

# 本地模型：宿主机 8080 上的 Qwen 27B（OpenAI 兼容接口）
# bot 跑在 Docker 里时用 host.docker.internal 访问宿主机
LOCAL_BASE_URL=http://host.docker.internal:8080/v1
# llama.cpp 会忽略模型名；vLLM / Ollama 需要填实际的模型名（可用 curl <地址>/v1/models 查看）
LOCAL_MODEL=qwen

# DeepSeek V4.1 Flash，每人每天 10 次
# 模型名请以 DeepSeek 官方文档为准（报道里有 deepseek-flash 和 deepseek-v4.1-flash 两种说法）
FLASH_BASE_URL=https://api.deepseek.com
FLASH_API_KEY=
FLASH_MODEL=deepseek-flash
FLASH_DAILY_LIMIT=10

# 生图：宿主机 8188 上的 ComfyUI
# workflows/ 目录下每个 .json 是一个工作流，文件名就是 /画 后面用的名字（如 flux.json、h3.json）
IMAGE_BACKEND=comfyui
IMAGE_BASE_URL=http://host.docker.internal:8188
IMAGE_DEFAULT_WORKFLOW=flux
# 单次生成最长等待秒数（视频可以调大）
IMAGE_TIMEOUT=600
# 默认每人每天次数，0 = 不限
IMAGE_DAILY_LIMIT=0
# 按工作流单独限次，例如 h3 走付费 API 时：IMAGE_LIMITS={"h3": 3}
IMAGE_LIMITS={}

# 大肥鱼随机插话
# 群友普通消息的回复概率（0.1 = 10%），0 表示只在被 @ 时回复
RANDOM_REPLY_PROB=0.1
# 同一个群两次随机插话至少间隔多少秒
RANDOM_REPLY_COOLDOWN=60
# 只在这些群随机插话，例如 [123456,789012]；空列表表示所有群
RANDOM_REPLY_GROUPS=[]
# 群主/群管理员的消息是否也必回（SUPERUSERS 的消息总是必回）
ALWAYS_REPLY_GROUP_ADMINS=false

# 读图：消息或被引用的消息里有图片时，连图一起发给本地模型
VISION_ENABLED=true
# 留空 = 用 LOCAL_MODEL；聊天模型不支持看图时，填一个视觉模型（如 ollama 里的 qwen 视觉版）
VISION_MODEL=
