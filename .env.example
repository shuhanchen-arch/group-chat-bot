# 复制为 .env 后修改
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
# NapCat 反向 WebSocket 连接时使用的 token，两边填一样
ONEBOT_ACCESS_TOKEN=change-me
COMMAND_START=["/"]
NICKNAME=["机器人"]
# 你的大号 QQ，不受次数限制
SUPERUSERS=["123456789"]

# 本地模型（Ollama 默认地址；bot 跑在 Docker 里时用 host.docker.internal）
LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_MODEL=qwen3:8b

# DeepSeek V4.1 Flash，每人每天 10 次
# 模型名请以 DeepSeek 官方文档为准（报道里有 deepseek-flash 和 deepseek-v4.1-flash 两种说法）
FLASH_BASE_URL=https://api.deepseek.com
FLASH_API_KEY=
FLASH_MODEL=deepseek-flash
FLASH_DAILY_LIMIT=10

# 生图：sdwebui = 本地 Stable Diffusion WebUI / Forge（启动时加 --api）
#       openai  = 任意 OpenAI 兼容的 /images/generations 接口
IMAGE_BACKEND=sdwebui
IMAGE_BASE_URL=http://host.docker.internal:7860
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_STEPS=25
# 0 = 不限
IMAGE_DAILY_LIMIT=0
